; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Increment"
config/description="Life aboard a space station. The timeline is the job."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.925, 0.906, 0.871, 1)
boot_splash/show_image=false

[debug]

gdscript/warnings/enable=false

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.925, 0.906, 0.871, 1)
